# OpenWeatherMap API Key
# Get your free API key from: https://openweathermap.org/api
# 1. Create a free account at https://home.openweathermap.org/users/sign_up
# 2. Go to API Keys section in your profile
# 3. Copy your default API key or generate a new one
# 4. Paste it below (replace YOUR_API_KEY_HERE)

OPENWEATHER_API_KEY=YOUR_API_KEY_HERE

# Server Port (optional, defaults to 3000)
PORT=3000
